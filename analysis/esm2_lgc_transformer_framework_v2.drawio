        <mxCell id="det-mean" value="有效邻居均值" style="rounded=1;html=1;fillColor=#E6F5F0;strokeColor=#008773;fontFamily=Helvetica;fontSize=22;fontColor=#005B4E;" vertex="1" parent="1"><mxGeometry x="770" y="263" width="200" height="58" as="geometry"/></mxCell>
        <mxCell id="det-outproj" value="OutProj&lt;br&gt;+ Dropout" style="rounded=1;html=1;fillColor=#E6F5F0;strokeColor=#008773;fontFamily=Helvetica;fontSize=22;fontColor=#005B4E;" vertex="1" parent="1"><mxGeometry x="1036" y="255" width="180" height="74" as="geometry"/></mxCell>
        <mxCell id="det-add" value="+" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#008773;strokeWidth=2;fontFamily=Helvetica;fontSize=30;fontColor=#005B4E;" vertex="1" parent="1"><mxGeometry x="1280" y="268" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="det-hout" value="h_i + g_i" style="rounded=1;html=1;fillColor=#B2DFD1;strokeColor=#008773;fontFamily=Helvetica;fontSize=24;fontColor=#005B4E;" vertex="1" parent="1"><mxGeometry x="1380" y="263" width="150" height="58" as="geometry"/></mxCell>
        <mxCell id="det-e1" style="endArrow=block;endFill=1;strokeColor=#303B45;strokeWidth=2;" edge="1" parent="1" source="det-neighbor" target="det-concat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="det-e2" style="endArrow=block;endFill=1;strokeColor=#303B45;strokeWidth=2;" edge="1" parent="1" source="det-edge" target="det-concat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="det-e3" style="endArrow=block;endFill=1;strokeColor=#303B45;strokeWidth=2;" edge="1" parent="1" source="det-concat" target="det-msg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="det-e4" style="endArrow=block;endFill=1;strokeColor=#303B45;strokeWidth=2;" edge="1" parent="1" source="det-msg" target="det-mean"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="det-e5" style="endArrow=block;endFill=1;strokeColor=#303B45;strokeWidth=2;" edge="1" parent="1" source="det-mean" target="det-outproj"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="det-e6" style="endArrow=block;endFill=1;strokeColor=#303B45;strokeWidth=2;" edge="1" parent="1" source="det-outproj" target="det-add"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="det-e7" style="endArrow=block;endFill=1;strokeColor=#303B45;strokeWidth=2;" edge="1" parent="1" source="det-add" target="det-hout"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="det-residual" value="中心残基特征 h_i" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#303B45;strokeWidth=2;entryX=0.5;entryY=0;fontFamily=Helvetica;fontSize=20;fontColor=#005B4E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" target="det-add"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="210" as="sourcePoint"/><Array as="points"><mxPoint x="1304" y="210"/></Array></mxGeometry></mxCell>
        <mxCell id="det-mask-caption" value="候选邻居：坐标有效、非自身、距离小于 30 Å；最多取 16 个。不存在结构 KV 注意力调制。" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontFamily=Helvetica;fontSize=20;fontColor=#005B4E;" vertex="1" parent="1"><mxGeometry x="285" y="350" width="1250" height="33" as="geometry"/></mxCell>
        <mxCell id="det-loss-bg" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="1520" height="258" as="geometry"/></mxCell>
        <mxCell id="det-loss-title" value="D｜先计算相同的逐残基损失，再改变聚合规则" style="text;html=1;strokeColor=none;fillColor=#FFF3E3;align=left;spacingLeft=15;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#8C4900;" vertex="1" parent="1"><mxGeometry x="42" y="427" width="1516" height="47" as="geometry"/></mxCell>
        <mxCell id="det-loss-common" value="逐残基 weighted focal&lt;br&gt;ell = w(y) · (1 − p_t)^2 · BCE(z,y)&lt;br&gt;w+ = clip(sqrt(N− / N+), 1, 5)" style="rounded=1;html=1;fillColor=#FFF3E3;strokeColor=#D97706;fontFamily=Helvetica;fontSize=22;fontColor=#8C4900;" vertex="1" parent="1"><mxGeometry x="70" y="514" width="465" height="124" as="geometry"/></mxCell>
        <mxCell id="det-loss-r" value="&lt;b&gt;Residue mean&lt;/b&gt;&lt;br&gt;L_res = sum_b sum_i ell_bi / sum_b L_b&lt;br&gt;每条蛋白的平均损失按长度加权" style="rounded=1;html=1;fillColor=#FFF3E3;strokeColor=#D97706;fontFamily=Helvetica;fontSize=21;fontColor=#8C4900;" vertex="1" parent="1"><mxGeometry x="600" y="507" width="434" height="138" as="geometry"/></mxCell>
        <mxCell id="det-loss-p" value="&lt;b&gt;Protein mean&lt;/b&gt;&lt;br&gt;L_prot = mean_b [ mean_i (ell_bi) ]&lt;br&gt;每条蛋白的平均损失等权" style="rounded=1;html=1;fillColor=#FBD7A3;strokeColor=#D97706;strokeWidth=2;fontFamily=Helvetica;fontSize=21;fontColor=#8C4900;" vertex="1" parent="1"><mxGeometry x="1086" y="507" width="434" height="138" as="geometry"/></mxCell>
        <mxCell id="det-loss-arrow" style="endArrow=block;endFill=1;strokeColor=#303B45;strokeWidth=2;" edge="1" parent="1" source="det-loss-common" target="det-loss-r"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="det-loss-or" value="vs" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#8C4900;" vertex="1" parent="1"><mxGeometry x="1040" y="555" width="41" height="35" as="geometry"/></mxCell>
        <mxCell id="noteA" value="&lt;b&gt;A｜蓝色：离线特征提取&lt;/b&gt;&lt;br&gt;&lt;br&gt;ESM2 输出 L×2560；ESM3 输出预测 C-alpha 坐标。两路特征按残基对齐，不直接拼成 2563 维输入。滑窗重叠平均不等于 ESM2 跨窗口全局注意力。&lt;br&gt;&lt;br&gt;代码：feature_extra_clean.py；rna_dataset.py" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#EAF1FF;strokeColor=#2563EB;fontFamily=Helvetica;fontSize=20;fontColor=#1746A2;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="485" height="265" as="geometry"/></mxCell>
        <mxCell id="noteC" value="&lt;b&gt;C｜紫色：全局编码与预测&lt;/b&gt;&lt;br&gt;&lt;br&gt;先加正弦位置编码，再进入 4 层 pre-norm Transformer。隐藏维度 512、8 个头、FFN 2048。分类头为 LN → 512→256 → GELU → Dropout → 1；再 sigmoid。主图省略逐处 LN、残差和 Dropout。&lt;br&gt;&lt;br&gt;代码：lgc_transformer_model.py" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#F1EAFF;strokeColor=#7C3AED;fontFamily=Helvetica;fontSize=20;fontColor=#5425A0;" vertex="1" parent="1"><mxGeometry x="550" y="710" width="485" height="265" as="geometry"/></mxCell>
        <mxCell id="noteE" value="&lt;b&gt;E｜灰蓝色：验证与评估&lt;/b&gt;&lt;br&gt;&lt;br&gt;验证集以 MCC 选择模型与阈值，测试固定阈值。每个长度箱内汇集残基计算 MCC，不是逐蛋白 MCC 的均值。代码中的 aupr 使用 average precision，因此图中写 AP。&lt;br&gt;&lt;br&gt;代码：train.py；预测脚本；metrics.py" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#EDF0F4;strokeColor=#475569;fontFamily=Helvetica;fontSize=20;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1060" y="710" width="500" height="265" as="geometry"/></mxCell>
        <mxCell id="noteD" value="&lt;b&gt;损失实验的解释边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;蛋白等权改变的是蛋白之间的相对权重，不改变同一蛋白内的正负类比例。长蛋白 MCC 是否提高，必须由实验判断。应使用同一 Step1 脚本，仅切换 loss-norm，保持划分与其他设置一致。归一化发生在微批次内；梯度累积不等于对累计批次重新做全局残基平均。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFF3E3;strokeColor=#D97706;fontFamily=Helvetica;fontSize=20;fontColor=#8C4900;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="740" height="243" as="geometry"/></mxCell>
        <mxCell id="note-boundaries" value="&lt;b&gt;当前代码的实现边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;主图采用 Step1 分箱：1000–1499、≥1500；预测脚本将 1500 归入第三箱，比较前需统一。特征提取文件输出 label=None，不能直接接入要求 label.float() 的评估数据集。预测脚本默认权重不是 Step1 权重。图中矩阵、结构、颜色均为示意，不是测量结果。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#EDF0F4;strokeColor=#475569;fontFamily=Helvetica;fontSize=20;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="810" y="1000" width="750" height="243" as="geometry"/></mxCell>
        <mxCell id="edit-note" value="配色规则：颜色只表示模块归属；同一模块使用同色系深浅，模块间箭头统一深灰。主图字号 20–34，放大说明字号 20–34。用 draw.io 打开后可取消组合编辑矩阵色块、节点与连线；建议只导出第 1 页作为论文主图。" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=20;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="45" y="1270" width="1510" height="65" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
